# ---------------------------------------------------------------- server
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------- database
# Use the same Atlas cluster as the bot but a separate database.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.2qkx7r6.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=wagateway

# ---------------------------------------------------------------- auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES=7d

# ---------------------------------------------------------------- limits
MAX_SESSIONS_PER_USER=10
MAX_SESSIONS_TOTAL=500

# ---------------------------------------------------------------- pairing
DEFAULT_COUNTRY_CODE=92
PAIR_CODE_TTL_MS=110000

# ---------------------------------------------------------------- network
FETCH_TIMEOUT_MS=120000
CORS_ORIGIN=*
SERVE_WEB=true

# ---------------------------------------------------------------- seed
SEED_EMAIL=demo@wagateway.local
SEED_PASSWORD=demo12345
