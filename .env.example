# ---------------------------------------------------------------- server
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------- database
# Use the same Atlas cluster as the bot but a separate database.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.2qkx7r6.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=wagateway

# ---------------------------------------------------------------- auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES=7d

# ---------------------------------------------------------------- limits
MAX_SESSIONS_PER_USER=10
MAX_SESSIONS_TOTAL=500

# ---------------------------------------------------------------- pairing
DEFAULT_COUNTRY_CODE=92
PAIR_CODE_TTL_MS=110000

# ---------------------------------------------------------------- network
FETCH_TIMEOUT_MS=120000
CORS_ORIGIN=*
SERVE_WEB=true

# ---------------------------------------------------------------- seed
SEED_EMAIL=demo@wagateway.local
SEED_PASSWORD=demo12345

# ---------------------------------------------------------------- owner / mode
# Owner WhatsApp number (digits only). Used for private mode + labels.
OWNER_NUMBER=923106762478
# public = everyone can use commands, private = owner only
DEFAULT_MODE=public

# ---------------------------------------------------------------- presence
# appear online + double grey tick, never blue tick, never auto-read
ALWAYS_ONLINE=true
AUTO_READ=false
PRESENCE_INTERVAL_MS=25000

# ---------------------------------------------------------------- ai agent
AI_ENABLED=true
AI_TIMEOUT_MS=20000
AI_HISTORY_TURNS=8

# AI providers (tried in this order; leave blank to disable)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
